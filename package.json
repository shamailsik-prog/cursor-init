{
  "name": "sikander-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "test:all": "npm run test:unit && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sikander \"npx vitest run --no-file-parallelism tests/firestore.rules.lattice-dedicated-view-invariants.test.ts tests/firestore.rules.test.ts tests/firestore.rules.d1-phase2a.test.ts tests/persistence.repositories.test.ts tests/persistence.runtime-mode.test.ts\"",
    "gate:g0": "bash ci_gates/gate_g0.sh",
    "gate:g1": "python3 ci_gates/gate_g1.py",
    "gate:g2": "bash ci_gates/gate_g2.sh",
    "gate:g4:phase2a": "bash ci_gates/gate_g4_phase2a.sh",
    "mutation": "stryker run stryker.config.mjs",
    "mutation:functions": "npm --prefix functions run mutation",
    "eve:dev": "eve dev",
    "eve:info": "eve info"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "eve": "^0.56.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.43.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.27.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "eve": {
      "undici": "8.11.2"
    }
  }
}

{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "asia-south1"
  },
  "emulators": {
    "firestore": {
      "port": 18088,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "auth": {
      "port": 19099,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 15001,
      "host": "127.0.0.1"
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  }
}

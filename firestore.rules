rules_version = '2';
// SIKANDER AI — Firestore rules, Phase 0. Layer 18 §5.3 as extended by Erratum Set No. 1 (Job E).
// Every Phase 0 collection has a block. Default deny at the end. No rule ever grants another firmId.
service cloud.firestore {
  match /databases/{database}/documents {

    // SEC-3 / E-27: a signed-in caller is a live identity, not just a valid token. users/{uid} is
    // authoritative (written only by Cloud Functions): it must exist with active == true and the
    // same firmId, role and clearanceLevel as the token's claims, so a deactivated or demoted
    // user's still-valid ID token (up to 1 h) is refused; and the firm's E-19 MFA policy applies:
    // when firms/{firmId}.mfaEnforcedRoles lists the role, the token must record a second factor.
    // Read cost: every evaluated request (a get, a write, or a whole list query) reads users/{uid}
    // and firms/{firmId} once each — 2 billed document reads and 2 of the 10 access calls a request
    // may make (calls to the same document are cached). The heaviest rule, matter_members create,
    // now touches 4 distinct documents (users/{caller}, firms/{firmId}, the membership doc and
    // users/{assignee}).
    function signedIn() { return request.auth != null && liveUser() && mfaSatisfied(); }
    function tok() { return request.auth.token; }
    function liveUser() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('active', false) == true
        && u.get('firmId', '') == tok().get('firmId', null)
        && u.get('role', '') == tok().get('role', null)
        && u.get('clearanceLevel', '') == tok().get('clearanceLevel', null);
    }
    function mfaSatisfied() {
      let firmPath = /databases/$(database)/documents/firms/$(tok().get('firmId', '_none'));
      let enforced = exists(firmPath) ? get(firmPath).data.get('mfaEnforcedRoles', []) : [];
      let secondFactor = tok().get('firebase', {}).get('sign_in_second_factor', null);
      return !(enforced is list) || !(tok().get('role', '') in enforced) || (secondFactor is string && secondFactor != '');
    }
    function sameFirm() { return signedIn() && tok().firmId == resource.data.firmId; }
    function sameFirmNew() { return signedIn() && tok().firmId == request.resource.data.firmId; }
    function role() { return tok().role; }
    function isPartner() { return role() == 'partner'; }
    function rank(c) { return {'public': 0, 'internal': 1, 'confidential': 2, 'privileged': 3, 'privileged-restricted': 4}[c]; }
    function cleared(c) { return rank(tok().clearanceLevel) >= rank(c); }
    function isMember(matterId) { return exists(/databases/$(database)/documents/matter_members/$(matterId + '_' + request.auth.uid)); }
    function firmIdUnchanged() { return request.resource.data.firmId == resource.data.firmId; }
    function monotonic() { return rank(request.resource.data.classification) >= rank(resource.data.classification); }
    // Firm staff (platform/spine/store.ts Role minus 'client' and 'accounts'). Client-role users never see
    // internal collections; accounts reads the intimation register only (L17.6 #41), so it is not staff here.
    function isStaff() { return role() in ['partner', 'associate', 'clerk', 'intern']; }
    function isRegisterOnly() { return role() == 'accounts'; }
    // Membership-based read: L17.6 #41 "no matter documents" for accounts, even if added as a member.
    // R2 N5: membership-based reads are for matter staff only — never accounts (register-only) and
    // never a client-role user, even if (wrongly) added as a member. Clients read only their own
    // matters (matters.clientId), as the API allows.
    function memberReader(matterId) { return role() in ['partner', 'associate', 'clerk', 'intern'] && isMember(matterId); }
    // R1 #6: for collections whose rows may be firm-level (matterId null by type) — a null
    // matterId is firm-scoped, a set one needs membership, a missing field denies.
    function matterScoped(matterId) { return role() in ['partner', 'associate', 'clerk', 'intern'] && (matterId == null || isMember(matterId)); }
    function isAuthor() { return role() in ['partner', 'associate', 'clerk']; }   // interns/accounts/clients never author
    function clearedNew() { return cleared(request.resource.data.classification); }
    // Matter-bound -> membership; loose vault (matterId == null) -> clerk/partner with confidential+ clearance (L4.5).
    function canAccessScope(matterId) {
      return matterId != null ? isMember(matterId) : role() in ['clerk', 'partner'] && rank(tok().clearanceLevel) >= 2;
    }
    // Matter-bound staff roles that may read matter-derived rows (client and accounts never do).
    function isMatterStaff() { return role() in ['partner', 'associate', 'clerk', 'intern']; }
    // R1 #9: a matter-bound write is never below the matter's own classification.
    function atOrAboveMatter(matterId) {
      return matterId == null
        || rank(request.resource.data.classification)
           >= rank(get(/databases/$(database)/documents/matters/$(matterId)).data.classification);
    }
    // R1 #9 / R2 N7 / L17.3: a client-SDK create cannot prove its channel (only the server, via the
    // Admin SDK, stamps sourceChannel outside these rules), so every client-SDK document create is
    // treated as client-sourced: privileged at minimum, and any sourceChannel must be a known one.
    function clientSourcedFloor() {
      return rank(request.resource.data.classification) >= 3
        && request.resource.data.get('sourceChannel', 'web') in ['web', 'team_portal', 'whatsapp', 'bulk'];
    }
    function authorNew() { return sameFirmNew() && isAuthor() && clearedNew() && canAccessScope(request.resource.data.matterId); }
    // Audit F14 / O-76: a matter-bound row is read under its matter's CURRENT label, not only the label it was written
    // with, so a matter raised after the row was written binds the row too (as drafts and draft_versions). A loose-vault
    // row (matterId null) names no matter; a matter that cannot be read denies (get() of a missing document fails).
    // Cost (F14 R2-D5): reading a documents, document_versions or non-engine jobs row now costs two access calls per
    // distinct matter (the membership exists() and this matters get()), on top of the two identity calls (users, firms).
    // Rules allow 10 access calls per single-document request and 20 per transaction or batch, so a client transaction
    // or batch over rows of about nine or more distinct matters can be denied; split such work by matter.
    function clearedForMatterNow(matterId) {
      return matterId == null || cleared(get(/databases/$(database)/documents/matters/$(matterId)).data.classification);
    }

    match /firms/{firmId} {
      allow read: if signedIn() && tok().firmId == firmId;
      // Cloud Functions (Admin SDK) are the only writers: onboarding, mfaEnforcedRoles, dataResidency, plan.
      allow create, update, delete: if false;
    }
    match /users/{uid} {
      allow read: if sameFirm() && (isStaff() || request.auth.uid == uid);
      // users/{uid} is the authoritative identity record: role, clearanceLevel, active, firmId, mfaEnabled,
      // claimsVersion, deactivatedAt, updatedAt, createdAt are written only by Cloud Functions (Admin SDK),
      // which sync custom claims from it. Client SDK may change displayName only: on self, or a partner on a same-firm user.
      allow update: if sameFirm() && firmIdUnchanged() && (request.auth.uid == uid || isPartner())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow create, delete: if false; // Cloud Functions (Admin SDK) only
    }
    match /matter_members/{id} {
      // R-2: no role is exempt, including the founding partner — only members see a matter's membership.
      allow read: if sameFirm() && memberReader(resource.data.matterId);
      // isMember() keys on the doc id, so the id must be bound to the (immutable) matterId/userId fields.
      // R1 #6 (R-2, no role exempt): only a partner who is already a member assigns, and never
      // themselves — a non-member partner cannot self-assign into a matter. Initial membership of
      // a new matter is written server-side (matters API create).
      allow create: if sameFirmNew() && isPartner() && id == request.resource.data.matterId + '_' + request.resource.data.userId
        && isMember(request.resource.data.matterId) && request.resource.data.userId != request.auth.uid
        // Phase 2a: listMatters orders memberships by createdAt, so a client-SDK create must stamp it
        // with the server time (serverTimestamp()); a missing or client-chosen time is refused.
        && request.resource.data.get('createdAt', null) == request.time
        // R2 N5: the assignee must be an existing same-firm staff user (never client or accounts).
        && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.firmId == request.auth.token.firmId
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.role in ['partner', 'associate', 'clerk', 'intern'];
      allow update: if sameFirm() && isPartner() && isMember(resource.data.matterId) && firmIdUnchanged()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['matterId', 'userId', 'createdAt']);
      allow delete: if sameFirm() && isPartner() && isMember(resource.data.matterId);
    }
    match /clients/{id} {
      allow read: if sameFirm() && isStaff() && (!('classification' in resource.data) || cleared(resource.data.classification));
      // Phase 2a final review C1: registerClient (Cloud Functions, Admin SDK) is the only writer; it
      // assigns the client code, the entity and its duplicate-key links atomically, which no SDK write can.
      allow create, update: if false;
      allow delete: if false;
    }
    match /matters/{matterId} {
      // Layer 18 §5.3 + Job E: membership is the access source. No role exempt (including partner).
      // Missing classification fails closed (rank() of an absent field errors -> deny); every writer sets it.
      allow read: if sameFirm() && cleared(resource.data.classification)
        && (memberReader(matterId) || (role() == 'client' && resource.data.get('clientId', '') == request.auth.uid));
      // R3 N14: the matters API (which also creates the first member) is the only create path; a
      // client-SDK create made orphans that staff could not see but the named client could read.
      allow create: if false;
      // R2 N6: caseNumber / caseNumberStatus / courtId are written only by the API (partner-only,
      // audited); they feed the citation gate's own-case exemption.
      allow update: if sameFirm() && isMember(matterId) && firmIdUnchanged() && role() in ['partner', 'associate']
        && cleared(resource.data.classification) && clearedNew() && monotonic()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caseNumber', 'caseNumberStatus', 'courtId',
             // Phase 2a final review I1: lifecycle and identity fields move only through openMatter /
             // advanceStage / closeMatter (audited, one transaction with their events).
             'stage', 'status', 'clientId', 'matterNo', 'conflictCheckId', 'closedBy', 'closedAt', 'createdBy', 'createdAt']);
      allow delete: if false;
    }
    match /documents/{docId} {
      allow read: if sameFirm() && cleared(resource.data.classification)
        && (resource.data.matterId != null ? memberReader(resource.data.matterId)
            : role() in ['clerk', 'partner'] && rank(tok().clearanceLevel) >= 2)   // loose vault (L4.5); intern denied
        && clearedForMatterNow(resource.data.matterId);
      allow create: if authorNew() && atOrAboveMatter(request.resource.data.matterId) && clientSourcedFloor();
      allow update: if sameFirm() && firmIdUnchanged() && monotonic()
        && isAuthor() && cleared(resource.data.classification) && clearedNew()
        && canAccessScope(resource.data.matterId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storagePath', 'contentHash', 'isImmutable', 'matterId', 'firmId']);
      allow delete: if false; // originals are immutable; loose vault never deletes (E-18)
    }
    match /document_versions/{id} {
      // R-2: same scope as documents — matter membership (or the loose-vault rule) plus clearance.
      // Audit F14 / O-76: and cleared for the matter's current label (versions carry their document's matterId).
      allow read: if sameFirm() && isMatterStaff() && cleared(resource.data.classification)
        && canAccessScope(resource.data.matterId)
        && clearedForMatterNow(resource.data.matterId);
      allow create: if authorNew() && atOrAboveMatter(request.resource.data.matterId) && clientSourcedFloor();
      allow update, delete: if false; // append-only
    }
    match /entities/{id} {
      // Phase 2a: entities feed the conflict engine; registerClient (Cloud Functions) is the only
      // writer, so the client SDK never creates or edits one. Missing classification fails closed.
      allow read: if sameFirm() && isStaff() && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    // Phase 2b-A (P2-36, E-41(c)): server-only. No writer exists; reads by same-firm staff cleared
    // to the row. Missing classification fails closed (rank() of an absent field errors -> deny).
    match /entity_aliases/{id} {
      allow read: if sameFirm() && isStaff() && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    // Phase 2b-A (P2-36, E-41(c)): server-only and immutable. confirmMerge (Cloud Functions, Admin
    // SDK) is the only writer; the Phase 0 partner revert-only SDK update (L9355) is withdrawn,
    // because a revert outside the 2b-B saga is a half-state (L8414). Reads by same-firm partner or
    // associate cleared to the row; missing classification fails closed.
    match /merge_events/{id} {
      allow read: if sameFirm() && role() in ['partner', 'associate'] && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    // Phase 2a (matter spine + Module 6 conflict engine, spec §5): every collection below is written
    // only by Cloud Functions (Admin SDK). Reads are scoped by firm, role and clearance on the row's
    // classification; a row without classification fails closed (rank() of an absent field errors).
    match /entity_links/{id} {
      allow read: if sameFirm() && isStaff() && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    match /conflict_checks/{id} {
      // Partner only: the stored row is unredacted (hits[].matterId / matterNo / matterClassification,
      // boundMatterId); discloseFor redacts those server-side, so the requester reads via getConflictResult.
      allow read: if sameFirm() && isPartner() && isStaff() && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    match /conflict_events/{id} {
      allow read: if sameFirm() && isPartner() && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    match /matter_parties/{id} {
      // A partner, or a member of the party's matter; a standalone registry row (matterId null) is partner-only.
      allow read: if sameFirm() && cleared(resource.data.classification)
        && (isPartner() || memberReader(resource.data.matterId));
      allow create, update, delete: if false;
    }
    match /matter_events/{id} {
      allow read: if sameFirm() && memberReader(resource.data.matterId) && cleared(resource.data.classification);
      allow create, update, delete: if false;
    }
    // Server-only: numbering and daily-cap counters, the firm transliteration map, the domain event outbox.
    match /counters/{id} { allow read, write: if false; }
    match /transliteration_map/{id} { allow read, write: if false; }
    match /events/{id} { allow read, write: if false; }
    // Phase 3d P1 (P3-72): the AI cost log, the month totals, the budget alerts and the firm's AI config are
    // written and read by Cloud Functions only; partners read usage through getAiUsage. The platform kill
    // switch, platform/p1, is server-only through the catch-all below like the rest of `platform/*`
    // (tests/firestore.rules.test.ts pins that no `platform` match block exists).
    match /ai_usage_logs/{id} { allow read, write: if false; }
    match /ai_usage_months/{id} { allow read, write: if false; }
    match /ai_budget_alerts/{id} { allow read, write: if false; }
    match /ai_config/{id} { allow read, write: if false; }
    match /evidence_items/{id} {
      allow read: if sameFirm() && memberReader(resource.data.matterId) && cleared(resource.data.classification);
      allow create: if sameFirmNew() && isAuthor() && clearedNew() && isMember(request.resource.data.matterId);
      allow update: if sameFirm() && isAuthor() && isMember(resource.data.matterId) && firmIdUnchanged() && monotonic()
        && cleared(resource.data.classification) && clearedNew()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['matterId', 'firmId']);
      allow delete: if false;
    }
    match /custody_events/{id} {
      allow read: if sameFirm() && memberReader(resource.data.matterId);
      allow create: if sameFirmNew() && isAuthor() && clearedNew() && isMember(request.resource.data.matterId);
      allow update, delete: if false; // append-only
    }
    match /propositions/{id} {
      allow read: if sameFirm() && memberReader(resource.data.matterId);
      allow create: if sameFirmNew() && isMember(request.resource.data.matterId) && role() in ['partner', 'associate'];
      allow update: if sameFirm() && isMember(resource.data.matterId) && firmIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supersededBy', 'type', 'supports', 'confidence']);  // promote / supersede only
      allow delete: if false;
    }
    // Phase 4a (P4-11): the draft store is written by Cloud Functions only (the Admin SDK, in transactions with the
    // audit row and the event), so no client can forge `gateResult`, `status`, `locked` or `approvedBy`. A draft and
    // its versions are created, saved, restored and approved through /api/d4/drafting only. Reads follow the API's
    // `draft.read` (P4-10): an author role (partner, associate, clerk; interns stay denied, O-68 closed) who is a
    // member of the draft's matter (R-2) and is cleared for the row's own label and for the matter's current label,
    // so a label raised after a draft or a version was written binds it too (final review PROBE-5).
    match /drafts/{id} {
      allow read: if sameFirm() && isAuthor() && isMember(resource.data.matterId) && cleared(resource.data.classification)
        && cleared(get(/databases/$(database)/documents/matters/$(resource.data.matterId)).data.classification);
      allow create, update, delete: if false;
    }
    match /draft_versions/{id} {
      allow read: if sameFirm() && isAuthor() && isMember(resource.data.matterId) && cleared(resource.data.classification)
        && cleared(get(/databases/$(database)/documents/matters/$(resource.data.matterId)).data.classification);
      allow create, update, delete: if false; // append-only, and written by Cloud Functions only
    }
    // Phase 4a (P4-6, P4-7, P4-11): the gate's stored results and the partner's overrides are server-only: no client
    // reads or writes them; partners see a summary through getDraft and the gate routes.
    match /draft_gate_results/{id} { allow read, write: if false; }
    match /draft_gate_overrides/{id} { allow read, write: if false; }
    match /change_proposals/{id} {
      allow read: if sameFirm() && isStaff();
      allow create: if sameFirmNew() && isAuthor() && clearedNew() && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['decidedBy', 'decidedAt', 'reason']);   // partner approval is the only way out of pending
      allow update: if sameFirm() && isPartner() && firmIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'reason']);
      allow delete: if false;
    }
    match /master_versions/{id} {
      allow read: if sameFirm() && isStaff();
      allow write: if false; // P6 / Postgres is the system of record; the mirror is read-only
    }
    match /routing_queue/{id}  { allow read: if sameFirm() && role() in ['clerk', 'partner', 'associate']; allow write: if false; }
    // R-2: a follow-up is visible to members of its matter only (FollowUp.matterId is required;
    // a row without it is denied).
    match /follow_ups/{id}     { allow read: if sameFirm() && isStaff()
      && isMember(resource.data.matterId); allow write: if false; }
    // L17.6 #41: accounts reads the register firm-wide (register-only role); partners and associates
    // read a matter's intimation row only as members (R-2).
    match /intimation_register/{id} { allow read: if sameFirm() && (isRegisterOnly()
      || (role() in ['partner', 'associate'] && isMember(resource.data.matterId))); allow write: if false; }
    match /notifications/{id} {
      allow read: if sameFirm() && resource.data.userId == request.auth.uid;
      allow update: if sameFirm() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }
    // R-2 / L18 §5.2 (jobs carry classification): cleared and matter-scoped. Every job carries its
    // document's matterId (null = loose vault); a row without the field (pre-backfill) is denied.
    // P3-14: a P2 engine row (it carries `engine`) is never read through the SDK, only through the
    // /api/platform/jobs routes (restricted view, firm-level partner-only, never the payload).
    // Audit F14: a matter-bound row also needs clearance for the matter's current label (as drafts),
    // so a matter raised after the job was written binds the job too, and the matter must be the row's
    // firm's (R1-D6); a loose-vault row is unchanged. The two get()s of one matter are one read.
    match /jobs/{id}           { allow read: if sameFirm() && !('engine' in resource.data)
      && role() in ['partner', 'associate', 'clerk']
      && cleared(resource.data.classification)
      && canAccessScope(resource.data.matterId)
      && clearedForMatterNow(resource.data.matterId)
      && (resource.data.matterId == null
        || get(/databases/$(database)/documents/matters/$(resource.data.matterId)).data.firmId == resource.data.firmId); allow write: if false; }
    match /api_keys/{id}       { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /audit_log/{id}      { allow read: if sameFirm() && isPartner(); allow write: if false; }
    // R3 N13: full rows that could not be persisted; written by the server (Admin SDK) only.
    match /audit_dead_letter/{id} { allow read, write: if false; }
    match /tenancy_session_references/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_dispute_attestations/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_reconciliation_digests/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_reconciliation_queue_arbitrations/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_digest_closure_checkpoints/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_closure_adjudications/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_arbitration_debt_retirement_ledgers/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_closure_adjudication_settlements/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_arbitration_debt_retirement_dispute_ledgers/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_external_session_identity_bridges/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /committee_outputs/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && matterScoped(resource.data.matterId); allow write: if false; }
    match /matter_client_search_index/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && (resource.data.rowType == 'matter' ? memberReader(resource.data.referenceId)
      : resource.data.linkedMatterId == null || memberReader(resource.data.linkedMatterId)); allow write: if false; }
    match /draft_template_analytics/{id} { allow read: if sameFirm() && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /matter_report_export_analytics/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && memberReader(resource.data.matterId); allow write: if false; }
    match /matter_report_relevance_snapshots/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && memberReader(resource.data.matterId); allow write: if false; }
    match /workflow_ops_activity/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && matterScoped(resource.data.matterId); allow write: if false; }
    match /workflow_ops_alert_digests/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && matterScoped(resource.data.matterId); allow write: if false; }
    match /workflow_ops_alert_attestations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && memberReader(resource.data.matterId); allow write: if false; }
    match /workflow_ops_alert_escalation_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && memberReader(resource.data.matterId); allow write: if false; }
    match /workflow_ops_alert_attestation_disputes/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk'] && memberReader(resource.data.matterId); allow write: if false; }

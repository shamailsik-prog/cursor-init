rules_version = '2';
// SIKANDER AI — Firestore rules, Phase 0. Layer 18 §5.3 as extended by Erratum Set No. 1 (Job E).
// Every Phase 0 collection has a block. Default deny at the end. No rule ever grants another firmId.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function tok() { return request.auth.token; }
    function sameFirm() { return signedIn() && tok().firmId == resource.data.firmId; }
    function sameFirmNew() { return signedIn() && tok().firmId == request.resource.data.firmId; }
    function role() { return tok().role; }
    function isPartner() { return role() == 'partner'; }
    function rank(c) { return {'public': 0, 'internal': 1, 'confidential': 2, 'privileged': 3, 'privileged-restricted': 4}[c]; }
    function cleared(c) { return rank(tok().clearanceLevel) >= rank(c); }
    function isMember(matterId) { return exists(/databases/$(database)/documents/matter_members/$(matterId + '_' + request.auth.uid)); }
    function memberOrPartner(matterId) { return isPartner() || isMember(matterId); }
    function firmIdUnchanged() { return request.resource.data.firmId == resource.data.firmId; }
    function monotonic() { return rank(request.resource.data.classification) >= rank(resource.data.classification); }

    match /firms/{firmId} {
      allow read: if signedIn() && tok().firmId == firmId;
      allow write: if signedIn() && tok().firmId == firmId && isPartner();
    }
    match /users/{uid} {
      allow read: if sameFirm();
      allow update: if sameFirm() && firmIdUnchanged() && (request.auth.uid == uid
                      ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'clearanceLevel', 'mfaEnabled', 'firmId'])
                      : isPartner());
      allow create, delete: if false; // Admin SDK (P5) only
    }
    match /matter_members/{id} {
      allow read: if sameFirm() && memberOrPartner(resource.data.matterId);
      allow create: if sameFirmNew() && isPartner();
      allow update: if sameFirm() && isPartner() && firmIdUnchanged();
      allow delete: if sameFirm() && isPartner();
    }
    match /clients/{id} {
      allow read: if sameFirm() && (!('classification' in resource.data) || cleared(resource.data.classification));
      allow create: if sameFirmNew() && role() in ['partner', 'associate', 'clerk'];
      allow update: if sameFirm() && firmIdUnchanged() && role() in ['partner', 'associate', 'clerk'];
      allow delete: if false;
    }
    match /matters/{matterId} {
      // Layer 18 §5.3 + Job E: membership is the access source. No role exempt (including partner).
      allow read: if sameFirm() && isMember(matterId);
      allow create: if sameFirmNew() && role() in ['partner', 'associate'];
      allow update: if sameFirm() && isMember(matterId) && firmIdUnchanged() && role() in ['partner', 'associate'];
      allow delete: if false;
    }
    match /documents/{docId} {
      allow read: if sameFirm() && cleared(resource.data.classification)
        && (resource.data.matterId != null ? isMember(resource.data.matterId)
            : role() in ['clerk', 'partner'] && rank(tok().clearanceLevel) >= 2);   // loose vault (L4.5); intern denied
      allow create: if sameFirmNew() && role() in ['partner', 'associate', 'clerk'];
      allow update: if sameFirm() && firmIdUnchanged() && monotonic()
        && (resource.data.matterId == null
              ? role() in ['clerk', 'partner']
              : isMember(resource.data.matterId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['storagePath', 'contentHash', 'isImmutable']);
      allow delete: if false; // originals are immutable; loose vault never deletes (E-18)
    }
    match /document_versions/{id} {
      allow read: if sameFirm() && cleared(resource.data.classification);
      allow create: if sameFirmNew();
      allow update, delete: if false; // append-only
    }
    match /entities/{id} {
      allow read: if sameFirm();
      allow create, update: if sameFirmNew() && role() in ['partner', 'associate'] && (resource == null || firmIdUnchanged());
      allow delete: if false;
    }
    match /entity_aliases/{id} {
      allow read: if sameFirm();
      allow create, update: if sameFirmNew() && role() in ['partner', 'associate', 'clerk'] && (resource == null || firmIdUnchanged());
      allow delete: if false;
    }
    match /merge_events/{id} {
      allow read: if sameFirm();
      allow create: if sameFirmNew() && role() in ['partner', 'associate'];
      allow update: if sameFirm() && isPartner() && firmIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reverted', 'revertedBy', 'revertedAt']);
      allow delete: if false;
    }
    match /evidence_items/{id} {
      allow read: if sameFirm() && isMember(resource.data.matterId) && cleared(resource.data.classification);
      allow create: if sameFirmNew() && isMember(request.resource.data.matterId) && role() in ['partner', 'associate', 'clerk'];
      allow update: if sameFirm() && isMember(resource.data.matterId) && firmIdUnchanged() && monotonic();
      allow delete: if false;
    }
    match /custody_events/{id} {
      allow read: if sameFirm() && isMember(resource.data.matterId);
      allow create: if sameFirmNew() && isMember(request.resource.data.matterId);
      allow update, delete: if false; // append-only
    }
    match /propositions/{id} {
      allow read: if sameFirm() && isMember(resource.data.matterId);
      allow create: if sameFirmNew() && isMember(request.resource.data.matterId) && role() in ['partner', 'associate'];
      allow update: if sameFirm() && isMember(resource.data.matterId) && firmIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supersededBy', 'type', 'supports', 'confidence']);  // promote / supersede only
      allow delete: if false;
    }
    match /drafts/{id} {
      allow read: if sameFirm() && isMember(resource.data.matterId) && cleared(resource.data.classification);
      allow create: if sameFirmNew() && isMember(request.resource.data.matterId);
      allow update: if sameFirm() && isMember(resource.data.matterId) && firmIdUnchanged() && monotonic();
      allow delete: if false;
    }
    match /draft_versions/{id} {
      allow read: if sameFirm() && cleared(resource.data.classification);
      allow create: if sameFirmNew();
      allow update, delete: if false; // append-only
    }
    match /change_proposals/{id} {
      allow read: if sameFirm();
      allow create: if sameFirmNew();
      allow update: if sameFirm() && isPartner() && firmIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'reason']);
      allow delete: if false;
    }
    match /master_versions/{id} {
      allow read: if sameFirm();
      allow write: if false; // P6 / Postgres is the system of record; the mirror is read-only
    }
    match /routing_queue/{id}  { allow read: if sameFirm() && role() in ['clerk', 'partner', 'associate']; allow write: if false; }
    match /follow_ups/{id}     { allow read: if sameFirm(); allow write: if false; }
    match /intimation_register/{id} { allow read: if sameFirm() && role() in ['partner', 'associate', 'accounts']; allow write: if false; }
    match /notifications/{id} {
      allow read: if sameFirm() && resource.data.userId == request.auth.uid;
      allow update: if sameFirm() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }
    match /jobs/{id}           { allow read: if sameFirm() && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /api_keys/{id}       { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /audit_log/{id}      { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_session_references/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_dispute_attestations/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_reconciliation_digests/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_reconciliation_queue_arbitrations/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_digest_closure_checkpoints/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_closure_adjudications/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_arbitration_debt_retirement_ledgers/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_closure_adjudication_settlements/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_lineage_arbitration_debt_retirement_dispute_ledgers/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /tenancy_external_session_identity_bridges/{id} { allow read: if sameFirm() && isPartner(); allow write: if false; }
    match /committee_outputs/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /matter_client_search_index/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /draft_template_analytics/{id} { allow read: if sameFirm() && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /matter_report_export_analytics/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /matter_report_relevance_snapshots/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_activity/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_digests/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_attestations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_escalation_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_attestation_disputes/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_escalation_closures/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_dispute_enforcement_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_closure_debt_reconciliation_digests/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_enforcement_attestations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_closure_debt_variance_digests/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_enforcement_waiver_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_queues/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_digests/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_disputes/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_escalations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudications/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoints/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_stewardships/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_remediations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_exception_reconciliations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndowns/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_orchestrations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlements/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_drains/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_attestations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_drain_reconciliations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_arbitrations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_reentry_compliances/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_arbitration_disposition_finalizations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_reentry_compliance_debt_retirements/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_arbitration_disposition_publication_governances/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_reentry_compliance_debt_retirement_dispute_reconciliations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_arbitration_disposition_publication_governance_external_distribution_audit_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_reentry_compliance_debt_retirement_dispute_reconciliation_closure_verifications/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_arbitration_disposition_publication_governance_external_distribution_audit_ledger_partner_handoff_attestations/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_reentry_compliance_debt_retirement_dispute_reconciliation_closure_verification_archival_exports/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_waiver_expiry_dispute_adjudication_slo_debt_burndown_settlement_arbitration_disposition_publication_governance_external_distribution_audit_ledger_partner_handoff_attestation_outbound_registry_attestation_ledgers/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }
    match /workflow_ops_alert_variance_remediation_sla_breach_resolution_checkpoint_expiry_attestation_queue_reentry_compliance_debt_retirement_dispute_reconciliation_closure_verification_archival_export_partner_delivery_receipts/{id} { allow read: if sameFirm() && cleared(resource.data.classification) && role() in ['partner', 'associate', 'clerk']; allow write: if false; }

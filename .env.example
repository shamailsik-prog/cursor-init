# Phase 0 does not require secrets.
# TODO(firm) O-2 / O-8: Firebase, R2, and Postgres connection strings belong here
# when those services exist. Do not invent residency, DPA, or bucket values.
#
# AI provider keys never belong here (audit F18). This file configures the Next.js and eve
# runtime, which has no provider path: paid AI calls run only in Cloud Functions P1
# (/api/platform/brain/committeeBrain), where the kill switches, the budget and the cost log
# apply. The AI Gateway key is bound to the Functions `api` function only (Secret Manager).
# A provider key in this environment refuses every AI call in production, with an alert line,
# and eve refuses to start. G-0 [19] (ci_gates/check_next_ai_egress.py) fails a key set here.
#
# The committee route forwards to Cloud Functions P1 with the caller's own ID token. Server-side
# base URL of the Functions `api` function (https, or http to localhost only):
# SIKANDER_FUNCTIONS_API_BASE_URL=

#
# SIKANDER_PERSISTENCE_MODE selects where the API routes store data. It is required outside
# the test runner; when unset, requests fail with a configuration error (no silent default).
#   memory    — non-durable in-process storage, lost on every restart. Local development only.
#               Refused when NODE_ENV=production.
#   firestore — Admin SDK (firebase-admin). Set FIREBASE_PROJECT_ID and
#               GOOGLE_APPLICATION_CREDENTIALS for cloud, or FIRESTORE_EMULATOR_HOST locally.
# Uncomment deliberately for local development:
# SIKANDER_PERSISTENCE_MODE=memory
#
# API authentication (platform/p5/session.ts). Unset = "firebase" (fail closed):
# every /api call needs `Authorization: Bearer <Firebase ID token>` and
# `X-Firm-Id`. firebase-admin reads standard Google env; without either value
# below, authenticated routes return 503 "auth not configured".
# SIKANDER_AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# LOCAL-ONLY escape hatch: trusts the actorId/userId the request carries, with
# no token. Accepted only when NODE_ENV is "development" or "test" AND none of
# K_SERVICE, VERCEL, VERCEL_ENV, FUNCTION_TARGET, FIREBASE_CONFIG, GAE_SERVICE
# is set; anywhere else every authenticated route returns 503. Never put this
# in a deployed .env / .env.local.
# SIKANDER_AUTH_MODE=insecure-dev
#
# Web consoles (/, /ops) sign in with Firebase Auth and send Bearer + X-Firm-Id.
# Functions API base (defaults to same origin when unset):
# NEXT_PUBLIC_SIKANDER_FUNCTIONS_API_BASE_URL=http://127.0.0.1:15001
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sikander

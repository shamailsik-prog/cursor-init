{
  "name": "functions",
  "private": true,
  "version": "0.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "jobs:backfill": "node lib/cli/jobsBackfill.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "test:emu": "cd .. && npx firebase emulators:exec --only auth,firestore --project demo-sikander \"npm --prefix functions test\"",
    "mutation": "bash scripts/mutation.sh"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "firebase": "^11.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

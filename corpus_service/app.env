# Non-secret application settings for the corpus app containers (audit F30). Committed on
# purpose: it holds NO credentials, so ci_gates/check_compose_policy.py can read it and rejects it
# if a credential ever appears here. Secrets (store passwords, ENCRYPTION_KEY, ADMIN_API_KEY,
# SECRET_KEY, OPENAI_API_KEY) go in corpus_service/.env, which compose uses only to interpolate the
# per-service values in docker-compose.yml and never hands to a container.
#
# The compose stack is a production deployment (TLS, least-privilege roles), so the app's
# production validators are on: verified store TLS, strong distinct passwords, required app keys.
ENVIRONMENT=production
ALLOW_LOGIN_SCRAPING=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PLS_IMPORT_DIR=./imports/PakistanLawSite
GOOGLE_DRIVE_ENABLED=false
SCRAPER_DELAY_MIN=1.2
SCRAPER_DELAY_MAX=2.5
EMBEDDING_BATCH_SIZE=50
EMBEDDING_RPM_LIMIT=100
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi
# Trusted reverse proxy for X-Forwarded-For (audit F24 re-audit L1, L2). uvicorn reads this
# variable: it replaces the client address with the X-Forwarded-For client only for a peer listed
# here, and the public rate limit keys on that address. 127.0.0.1 (uvicorn's default) is the safe
# value: only a process inside the api container could hand in a client address.
# DEPLOY STEP: behind the TLS reverse proxy, set it to the proxy's address as the api container
# sees it (an IP or CIDR, never *), or every client shares the proxy's quota bucket. The api logs
# a warning at startup while, in production, it trusts only loopback.
FORWARDED_ALLOW_IPS=127.0.0.1

# Local development credentials only. The service defaults to production unless ENVIRONMENT (or
# APP_ENV) is explicitly "development"; in production/staging it refuses to start if the DATABASE_URL
# password is empty, a known default (e.g. "legal") or shorter than 16 characters, or if
# ENCRYPTION_KEY / ADMIN_API_KEY / SECRET_KEY are unset.
# docker-compose (audit F30) refuses to start without these; use unique values (openssl rand -hex 24).
# Postgres and Redis are not published on host ports; services reach them on the internal data network.
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/legal_scraper
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
OPENAI_API_KEY=
# Required when ENVIRONMENT=production|staging. Generate Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_API_KEY=
SECRET_KEY=
ENVIRONMENT=development
ALLOW_LOGIN_SCRAPING=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# PakistanLawSite: licensed API or import folder only (FINAL_2). Never login scraping.
PLS_API_KEY=
PLS_IMPORT_DIR=./imports/PakistanLawSite
GOOGLE_DRIVE_ENABLED=false
SCRAPER_DELAY_MIN=1.2
SCRAPER_DELAY_MAX=2.5
EMBEDDING_BATCH_SIZE=50
EMBEDDING_RPM_LIMIT=100
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi

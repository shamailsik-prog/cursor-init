# Local development credentials only. The service defaults to production unless ENVIRONMENT (or
# APP_ENV) is explicitly "development"; in production/staging it refuses to start if the DATABASE_URL
# password is empty, a known default (e.g. "legal") or shorter than 16 characters, if
# ENCRYPTION_KEY / ADMIN_API_KEY / SECRET_KEY are unset, if DATABASE_URL lacks
# sslmode=verify-full, or if REDIS_URL is not rediss://<acl user>:<password>@... (audit F30).
#
# docker-compose (audit F30) refuses to start without the eight values below; compose reads them
# from this file for interpolation. Use unique, URL-safe values (openssl rand -hex 24): the
# passwords are embedded in DATABASE_URL / REDIS_URL. Postgres and Redis are not published on host
# ports, speak TLS only (private CA issued by the `certs` service), and are reached on the internal
# data network.
#   POSTGRES_USER/POSTGRES_PASSWORD  bootstrap superuser: image init + scripts/rotate_postgres_password.sh
#                                    only; it cannot log in over the network.
#   APP_DB_USER/APP_DB_PASSWORD      runtime role of api/workers/beat: DML only. Must differ from POSTGRES_USER.
#   MIGRATE_DB_USER/MIGRATE_DB_PASSWORD  schema owner, used only by the one-shot `migrate` service.
#   REDIS_APP_USER/REDIS_APP_PASSWORD    Redis ACL user (no @admin/@dangerous); `default` is disabled.
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=
REDIS_APP_USER=
REDIS_APP_PASSWORD=
# Under docker compose, DATABASE_URL / REDIS_URL / REDIS_TLS_CA_FILE are set by docker-compose.yml
# for every app service (verify-full TLS as APP_DB_USER, rediss:// as REDIS_APP_USER) and override
# anything here. These two lines only matter when running the app outside compose, e.g.:
# DATABASE_URL=postgresql+asyncpg://<APP_DB_USER>:<APP_DB_PASSWORD>@<host>:5432/legal_scraper?sslmode=verify-full&sslrootcert=/path/to/ca.crt
# REDIS_URL=rediss://<REDIS_APP_USER>:<REDIS_APP_PASSWORD>@<host>:6379/0   (plus REDIS_TLS_CA_FILE=/path/to/ca.crt)
# TLS material: issued automatically (TLS_CERTS_MODE=auto) or validated only (external); see README.
TLS_CERTS_MODE=auto
OPENAI_API_KEY=
# Required when ENVIRONMENT=production|staging. Generate Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_API_KEY=
SECRET_KEY=
ENVIRONMENT=development
ALLOW_LOGIN_SCRAPING=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# PakistanLawSite: licensed API or import folder only (FINAL_2). Never login scraping.
PLS_API_KEY=
PLS_IMPORT_DIR=./imports/PakistanLawSite
GOOGLE_DRIVE_ENABLED=false
SCRAPER_DELAY_MIN=1.2
SCRAPER_DELAY_MAX=2.5
EMBEDDING_BATCH_SIZE=50
EMBEDDING_RPM_LIMIT=100
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi

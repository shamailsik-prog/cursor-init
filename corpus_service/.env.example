# corpus_service/.env: SECRETS ONLY (audit F30). Copy to .env (mode 600) and fill in.
#
# docker compose reads this file only to fill the ${VAR} references in docker-compose.yml. It is
# never given to a container (no service has `env_file: .env`) and .dockerignore keeps it out of
# the image, so each container receives only the credentials it uses (see README, "Data-store
# security"). Non-secret app settings live in the committed app.env.
#
# Use unique, URL-safe values (openssl rand -hex 24): the passwords are embedded in DATABASE_URL /
# REDIS_URL and in the Redis ACL rule. The secrets-preflight service refuses to start the stores
# unless every store password is >= 16 characters, URL-safe, not a known default, and all differ.
#
#   POSTGRES_USER/POSTGRES_PASSWORD      bootstrap superuser: image init + scripts/rotate_postgres_password.sh
#                                        only; it cannot log in over the network.
#   APP_DB_USER/APP_DB_PASSWORD          runtime role of api/worker-embed/beat: DML only. Must differ from POSTGRES_USER.
#   MIGRATE_DB_USER/MIGRATE_DB_PASSWORD  schema owner, used only by the one-shot `migrate` service.
#   REDIS_APP_USER/REDIS_APP_PASSWORD    Redis ACL user (no @admin/@dangerous); `default` is disabled.
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=
REDIS_APP_USER=
REDIS_APP_PASSWORD=
# Application secrets, required in production (app.env sets ENVIRONMENT=production for compose).
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_API_KEY=
# Named scoped operator credentials (required in production). JSON array; example:
# CORPUS_ADMIN_CREDENTIALS=[{"id":"alice-1","actor":"alice@firm","secret":"<openssl rand -hex 24>","scopes":["read","trigger"]},{"id":"bob-export","actor":"bob@firm","secret":"<openssl rand -hex 24>","scopes":["export"]}]
CORPUS_ADMIN_CREDENTIALS=
SECRET_KEY=
# Optional, not a secret: P1's p1CorpusEmbedding URL (FA-D3C-002). Empty disables embeddings. Only
# worker-embed receives it. The corpus holds no provider key: P1 calls the provider.
P1_EMBEDDING_URL=
# TLS material: issued automatically (auto) or validated only (external); see README.
TLS_CERTS_MODE=auto
#
# Running the app OUTSIDE compose (local development): the app also reads .env from its working
# directory. Then add, for example:
# ENVIRONMENT=development
# DATABASE_URL=postgresql+asyncpg://<APP_DB_USER>:<APP_DB_PASSWORD>@<host>:5432/legal_scraper?sslmode=verify-full&sslrootcert=/path/to/ca.crt
# REDIS_URL=rediss://<REDIS_APP_USER>:<REDIS_APP_PASSWORD>@<host>:6379/0
# REDIS_TLS_CA_FILE=/path/to/ca.crt

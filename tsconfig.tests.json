{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "functions/src/**/*.ts",
    "functions/test/**/*.ts"
  ],
  "exclude": ["node_modules", ".stryker-tmp", "reports", "corpus_service"]
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!functions/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent scratch
/agent-tools

# eve runtime cache (model catalog, sandbox, logs)
/.eve/

# python
__pycache__/
*.pyc

# corpus harvest outputs (FINAL_2 separate service tree)
corpus_service/live/
corpus_service/imports/
corpus_service/blackletter_state/
corpus_service/.env

# firebase emulator
firebase-debug.log
firestore-debug.log
ui-debug.log
.emulator/


# cloud functions workspace
/functions/lib/
/functions/node_modules/

# mutation testing (StrykerJS)
.stryker-tmp/
reports/
functions/.stryker-tmp/
functions/reports/
test-results/
